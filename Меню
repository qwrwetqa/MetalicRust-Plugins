                        FontSize = 30,
                        Align = TextAnchor.MiddleCenter,
                        Color = "1 1 1 1"
                    },
                    RectTransform =
                    {
                        AnchorMin = "0.03 0.62",
                        AnchorMax = "0.18 0.95"
                    }
                }, panelName);
            }

            if (!string.IsNullOrEmpty(kit.Remaining))
            {
                container.Add(new CuiLabel
                {
                    Text =
                    {
                        Text = kit.Remaining,
                        FontSize = 10,
                        Align = TextAnchor.MiddleCenter,
                        Color = "1 0.55 0.20 1",
