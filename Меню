                "КАЛЕНДАРЬ ВАЙПОВ",
                "ОБРАТНАЯ СВЯЗЬ",
                "КОРЗИНА"
            };

            float top = 0.82f;
            float height = 0.065f;
            float gap = 0.012f;

            for (int i = 0; i < buttons.Length; i++)
            {
                string title = buttons[i];

                float minY = top - (i + 1) * height - i * gap;
                float maxY = top - i * height - i * gap;

                string color =
                    title == active
                        ? config.ActiveColor
                        : config.ButtonColor;

                container.Add(new CuiButton
                {
                    Button =
                    {
                        Color = color,
                        Command = "metalicrustmenu.side \"" + title + "\""
                    },
                    RectTransform =
                    {
                        AnchorMin = "0.035 " + minY.ToString("0.###"),
                        AnchorMax = "0.235 " + maxY.ToString("0.###")
                    },
                    Text =
                    {
                        Text = title,
                        FontSize = 15,
                        Align = TextAnchor.MiddleCenter,
                        Color = "1 1 1 1",
                        Font = "RobotoCondensed-Bold.ttf"
                    }
                }, MainPanel);
            }
        }

