        #region Commands

        private void ChatMenuCommand(BasePlayer player, string command, string[] args)
        {
            if (player == null)
                return;

            if (!HasPermission(player))
                return;

            OpenMainMenu(player);
        }

        private void ConsoleOpenCommand(ConsoleSystem.Arg arg)
        {
            var player = arg.Player();

            if (player == null)
                return;

            if (!HasPermission(player))
                return;

            OpenMainMenu(player);
        }

        private void ConsoleCloseCommand(ConsoleSystem.Arg arg)
        {
            var player = arg.Player();

            if (player == null)
                return;

            DestroyMenu(player);
        }

        private void ConsoleChatCommand(ConsoleSystem.Arg arg)
        {
            var player = arg.Player();

            if (player == null)
                return;

            if (!HasPermission(player))
                return;

            OpenChatPage(player, 0);
        }

        private void ConsoleKitsCommand(ConsoleSystem.Arg arg)
        {
            var player = arg.Player();

            if (player == null)
                return;

            if (!HasPermission(player))
                return;

            OpenKitsPage(player, 0);
        }

        private void ConsolePageCommand(ConsoleSystem.Arg arg)
        {
            var player = arg.Player();

            if (player == null)
                return;

            if (!HasPermission(player))
                return;

            int page = 0;

            if (arg.Args != null && arg.Args.Length > 0)
                int.TryParse(arg.Args[0], out page);

            page = Mathf.Clamp(page, 0, 1);

            OpenKitsPage(player, page);
        }

        private void ConsoleKitTakeCommand(ConsoleSystem.Arg arg)
        {
            var player = arg.Player();

            if (player == null)
                return;

            if (arg.Args == null || arg.Args.Length == 0)
                return;

            string kitName = arg.Args[0];

            if (string.IsNullOrEmpty(kitName))
                return;

            DestroyMenu(player);

            /*
             * Основной вариант для IQKits:
             * вызываем обычную чат-команду /kit НАЗВАНИЕ.
             *
             * Это позволяет оставить выдачу китов самому IQKits.
             */
            player.SendConsoleCommand("chat.say", "/kit " + kitName);
        }

        private void ConsoleSideCommand(ConsoleSystem.Arg arg)
        {
            var player = arg.Player();

            if (player == null)
                return;

            if (arg.Args == null || arg.Args.Length == 0)
                return;

            string key = arg.Args[0];

            if (string.IsNullOrEmpty(key))
                return;

            if (key == "ЧАТ")
            {
                OpenChatPage(player, 0);
                return;
            }

            if (key == "КИТЫ")
            {
                OpenKitsPage(player, 0);
                return;
            }

            string command;

            if (!config.NavigationCommands.TryGetValue(key, out command))
                return;

            if (string.IsNullOrEmpty(command))
                return;

            DestroyMenu(player);

            if (!command.StartsWith("/"))
                command = "/" + command;

            player.SendConsoleCommand("chat.say", command);
        }

        private void ConsoleNoopCommand(ConsoleSystem.Arg arg)
        {
        }

