        #region Kits

        private void OpenKitsPage(BasePlayer player, int page)
        {
            DestroyMenu(player);

            var container = new CuiElementContainer();

            AddBackground(container);
            AddCloseButton(container);
            AddSideMenu(container, player, "КИТЫ");

            container.Add(new CuiPanel
            {
                Image =
                {
                    Color = config.PanelColor
                },
                RectTransform =
                {
                    AnchorMin = "0.245 0.16",
                    AnchorMax = "0.985 0.875"
                }
            }, MainPanel, ContentPanel);

            const int perPage = 12;

            int start = page * perPage;
            int end = Math.Min(start + perPage, config.Kits.Count);

            int index = 0;

            for (int i = start; i < end; i++)
            {
                KitData kit = config.Kits[i];

                int column = index % 4;
                int row = index / 4;

                float xMin = 0.02f + column * 0.255f;
                float xMax = xMin + 0.245f;

                float yMax = 0.82f - row * 0.235f;
                float yMin = yMax - 0.22f;

                AddKitCard(
                    container,
                    player,
                    kit,
                    xMin,
                    yMin,
                    xMax,
                    yMax
                );

                index++;
            }

            AddPageButtons(container, page);

            CuiHelper.AddUi(player, container);
        }

        private void AddKitCard(
