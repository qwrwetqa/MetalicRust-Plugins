        #region Permission

        private bool HasPermission(BasePlayer player)
        {
            if (player == null)
                return false;

            if (player.IsAdmin)
                return true;

            if (string.IsNullOrEmpty(config.Permission))
                return true;

            return permission.UserHasPermission(player.UserIDString, config.Permission);
        }

