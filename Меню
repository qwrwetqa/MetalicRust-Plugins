        {
            string[] buttons =
            {
                "ИНФОРМАЦИЯ",
                "ЧАТ",
                "КИТЫ",
                "РЕПОРТЫ",
                "МАГАЗИН",
                "ВАЙПБЛОК",
                "СТАТИСТИКА",
                "УВЕДОМЛЕНИЯ",
