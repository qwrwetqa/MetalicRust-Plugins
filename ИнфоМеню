        private void ConsoleOpen(ConsoleSystem.Arg arg) => OpenMenu(arg.Player(), 0, 0);

        [ConsoleCommand("infomenu.tab")]
        private void ConsoleTab(ConsoleSystem.Arg arg)
        {
            var player = arg.Player();
            if (player != null) OpenMenu(player, arg.GetInt(0, 0), arg.GetInt(1, 0));
        }

        [ConsoleCommand("infomenu.close")]
        private void ConsoleClose(ConsoleSystem.Arg arg) => DestroyMenu(arg.Player());

