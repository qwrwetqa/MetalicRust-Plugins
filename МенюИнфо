        private void RefreshGameStoreCartDataOnly(BasePlayer player)
        {
            Plugin plugin=GameStoresRUST ?? plugins.Find("GameStoresRUST");
            if(plugin==null){gameStoreBaskets[player.userID]=new List<GameStoreBasketItem>();OpenGameStoreInternalTab(player,"cart");return;}
            try
            {
                MethodInfo request=plugin.GetType().GetMethod("Request",BindingFlags.Instance|BindingFlags.NonPublic,null,new Type[]{typeof(string),typeof(Dictionary<string,string>),typeof(Action<int,string>),typeof(BasePlayer)},null);
                if(request==null){gameStoreBaskets[player.userID]=new List<GameStoreBasketItem>();OpenGameStoreInternalTab(player,"cart");return;}
                Action<int,string> callback=(code,response)=>
                {
                    var result=new List<GameStoreBasketItem>();
                    try
                    {
                        JObject json=JObject.Parse(response??"{}");
                        if(code==200 && string.Equals(json["result"]?.ToString(),"success",StringComparison.OrdinalIgnoreCase))
                        {
                            JArray data=json["data"] as JArray;
                            if(data!=null) foreach(JToken token in data)
                            {
                                JObject obj=token as JObject; int basketId,amount,itemId;
                                if(obj==null || !int.TryParse(obj["basketId"]?.ToString(),out basketId)) continue;
                                if(!int.TryParse(obj["amount"]?.ToString(),out amount)) amount=1;
                                int.TryParse(obj["data"]?["itemId"]?.ToString(),out itemId);
                                result.Add(new GameStoreBasketItem{BasketId=basketId,Name=obj["name"]?.ToString()??"Товар GameStores",Amount=amount,Type=obj["type"]?.ToString()??"",ProductId=obj["productId"]?.ToString()??"",ItemId=itemId,IsBlueprint=string.Equals(obj["type"]?.ToString(),"bp",StringComparison.OrdinalIgnoreCase)});
                            }
                        }
                    }catch(Exception ex){PrintWarning("[InfoMenu] Ошибка разбора корзины GameStores: "+ex.Message);}
                    gameStoreBaskets[player.userID]=result; OpenGameStoreInternalTab(player,"cart");
                };
                request.Invoke(plugin,new object[]{"baskets.bySteamId",new Dictionary<string,string>{{"steamId",player.UserIDString}},callback,player});
            }
            catch(Exception ex){PrintWarning("[InfoMenu] Ошибка запроса корзины GameStores: "+ex.Message);gameStoreBaskets[player.userID]=new List<GameStoreBasketItem>();OpenGameStoreInternalTab(player,"cart");}
        }

        private void TakeGameStoreItem(BasePlayer player,int basketId)
        {
            if(player==null || !player.IsConnected || basketId<=0) return;
            List<GameStoreBasketItem> items; GameStoreBasketItem item=null;
            if(gameStoreBaskets.TryGetValue(player.userID,out items) && items!=null) item=items.FirstOrDefault(x=>x.BasketId==basketId);
            if(item==null){player.ChatMessage("GameStores: товар не найден в корзине.");RefreshGameStoreCart(player);return;}
            Plugin plugin=GameStoresRUST ?? plugins.Find("GameStoresRUST");
            if(plugin==null){player.ChatMessage("GameStores: плагин магазина не найден.");return;}
            try
            {
                MethodInfo method=plugin.GetType().GetMethod("RequestGetItem",BindingFlags.Instance|BindingFlags.NonPublic,null,new Type[]{typeof(BasePlayer),typeof(int),typeof(int)},null);
                if(method==null){player.ChatMessage("GameStores: API выдачи товара не найдено.");return;}
                player.ChatMessage("GameStores: выдаём «"+(item.Name??"товар")+"»...");
                method.Invoke(plugin,new object[]{player,basketId,0});
                timer.Once(2f,()=>{if(player!=null&&player.IsConnected)RefreshGameStoreCart(player);});
            }
            catch(Exception ex){PrintWarning("[InfoMenu] Ошибка выдачи товара GameStores: "+ex.Message);player.ChatMessage("GameStores: ошибка выдачи товара.");}
        }

        private string GetShopDurationLabel(BasePlayer player, GameStoreProduct product)
        {
            if (product == null)
                return string.Empty;

            int duration = GetShopDisplayDuration(player, product);

            if (string.Equals(product.Title, "КОПТЕР", StringComparison.OrdinalIgnoreCase))
            {
                long remaining = GetShopRemainingCooldown(player, product);
                if (remaining > 0L)
                    return "10 мин";
                return "1 шт";
            }

            if (string.Equals(product.Title, "СКИНЫ", StringComparison.OrdinalIgnoreCase))
                return duration.ToString(CultureInfo.InvariantCulture) + " дней";

            if (!string.IsNullOrEmpty(product.Group))
                return duration.ToString(CultureInfo.InvariantCulture) + " дней";

            return duration.ToString(CultureInfo.InvariantCulture);
        }

        private int GetShopDisplayDuration(BasePlayer player, GameStoreProduct product)
        {
            if (product == null)
                return 0;

            if (player == null)
                return product.DurationDays;

            long remaining = GetShopRemainingCooldown(player, product);
            if (remaining <= 0)
                return product.DurationDays;

            return Mathf.Max(1, Mathf.CeilToInt(remaining / 86400f));
        }

        private long GetShopRemainingCooldown(BasePlayer player, GameStoreProduct product)
        {
            if (player == null || product == null)
                return 0L;

            long now = CurrentUnix();
            long expires = 0L;

            if (!string.IsNullOrEmpty(product.Group))
            {
                expires = GetTierExpiry(player, product.Group);
            }
            else if (string.Equals(product.Title, "СКИНЫ", StringComparison.OrdinalIgnoreCase))
            {
                PlayerData data = GetPlayerData(player);
                expires = data != null ? data.SkinsRefreshAt : 0L;
            }
            else if (string.Equals(product.Title, "КОПТЕР", StringComparison.OrdinalIgnoreCase))
            {
                PlayerData data = GetPlayerData(player);
                expires = data != null ? data.CopterRefreshAt : 0L;
            }

            return expires > now ? expires - now : 0L;
        }

