        private string FormatStatNumber(double value)
        {
            if (value < 1000d) return value.ToString("0", CultureInfo.InvariantCulture);
            if (value < 1000000d) return (value / 1000d).ToString("0.0", CultureInfo.InvariantCulture) + "K";
            return (value / 1000000d).ToString("0.0", CultureInfo.InvariantCulture) + "M";
        }

        private string GetPlayerStatNumber(BasePlayer player, params string[] names)
        {
            if (player == null || names == null) return "0";
            try
            {
                Type type = player.GetType();
                foreach (string name in names)
                {
                    FieldInfo field = type.GetField(name, BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.IgnoreCase);
                    if (field != null)
                    {
                        object value = field.GetValue(player);
                        double number;
                        if (TryConvertStat(value, out number)) return FormatStatNumber(number);
                    }
                    PropertyInfo property = type.GetProperty(name, BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.IgnoreCase);
                    if (property != null)
                    {
                        object value = property.GetValue(player, null);
                        double number;
                        if (TryConvertStat(value, out number)) return FormatStatNumber(number);
                    }
                }
            }
            catch { }
            return "0";
        }

        private bool TryConvertStat(object value, out double number)
        {
            number = 0d;
            if (value == null) return false;
            try
            {
                if (value is int) { number = (int)value; return true; }
                if (value is long) { number = (long)value; return true; }
                if (value is float) { number = (float)value; return true; }
                if (value is double) { number = (double)value; return true; }
                if (value is decimal) { number = (double)(decimal)value; return true; }
                return double.TryParse(value.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out number);
            }
            catch { return false; }
        }

        private string EscapeText(string text)
        {
            if (string.IsNullOrEmpty(text))
                return string.Empty;

            return text.Replace("<", "[").Replace(">", "]");
        }

