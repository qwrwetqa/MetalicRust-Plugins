        {
            if (player == null)
                return null;

            try
            {
                PropertyInfo property = typeof(BasePlayer).GetProperty(
                    "IPlayer",
                    BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);

                if (property != null)
                    return property.GetValue(player, null);
            }
            catch
            {
            }

            return null;
        }

        private string GetBetterChatPrimaryGroup(BasePlayer player)
        {
            if (BetterChat == null || player == null)
                return "default";

            object iPlayer = GetBetterChatPlayerObject(player);
            if (iPlayer == null)
                return "default";

            try
            {
                object result = BetterChat.Call("API_GetUserGroups", iPlayer);
                var groups = result as System.Collections.IEnumerable;
                if (groups == null) return "default";

                string best = "default";
                int bestPriority = int.MaxValue;
                foreach (object item in groups)
                {
                    JObject obj = item as JObject;
                    if (obj == null) continue;
                    string name = obj["GroupName"] == null ? null : obj["GroupName"].ToString();
                    int priority = 999999;
                    if (obj["Priority"] != null)
                    {
                        try { priority = obj["Priority"].Value<int>(); } catch { }
                    }
                    if (!string.IsNullOrEmpty(name) && priority < bestPriority)
                    {
                        best = name;
                        bestPriority = priority;
                    }
                }
                return best;
            }
            catch { return "default"; }
        }

        private bool HasChatGroup(BasePlayer player, string group)
        {
            if (string.IsNullOrEmpty(group) || BetterChat == null || player == null)
                return false;

            object iPlayer = GetBetterChatPlayerObject(player);
            if (iPlayer == null)
                return false;

            try
            {
                object result = BetterChat.Call("API_GetUserGroups", iPlayer);
                var groups = result as System.Collections.IEnumerable;
                if (groups == null) return false;
                foreach (object item in groups)
                {
                    JObject obj = item as JObject;
                    if (obj == null) continue;
                    string groupName = obj["GroupName"] == null ? string.Empty : obj["GroupName"].ToString();
                    if (string.Equals(groupName, group, StringComparison.OrdinalIgnoreCase))
                        return true;
                }
            }
            catch { }
            return false;
        }

