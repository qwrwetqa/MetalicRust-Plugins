        private void SetChatGroup(BasePlayer player, string group, List<ChatOption> options, string kind)
        {
            ChatOption selected = options.FirstOrDefault(x => x != null &&
                string.Equals(x.Group ?? "", group ?? "", StringComparison.OrdinalIgnoreCase));
            if (selected == null) return;

            if (!string.IsNullOrEmpty(selected.Permission) && !permission.UserHasPermission(player.UserIDString, selected.Permission))
            {
                player.ChatMessage("<color=#ff4444>У вас нет доступа к этому варианту.</color>");
                return;
            }

            if (BetterChat == null)
            {
                player.ChatMessage("<color=#ff4444>Better Chat не найден.</color>");
                return;
            }

            foreach (ChatOption option in options)
            {
                if (option == null || string.IsNullOrEmpty(option.Group)) continue;
                Server.Command("chat", "user", "remove", player.UserIDString, option.Group);
            }

            if (!string.IsNullOrEmpty(selected.Group))
                Server.Command("chat", "user", "add", player.UserIDString, selected.Group);

            player.ChatMessage("<color=#55ff22>" + kind + " установлен: " + selected.Title + "</color>");
            OpenChatPage(player, 0);
        }

