                        AnchorMin = string.Format(CultureInfo.InvariantCulture, "{0:0.###} {1:0.###}", xMin, yMin),
                        AnchorMax = string.Format(CultureInfo.InvariantCulture, "{0:0.###} {1:0.###}", xMax, yMax)
                    }
                }, shopLayer, card);

                container.Add(new CuiPanel
                {
                    Image = { Color = "0.18 0.20 0.20 1" },
                    RectTransform = { AnchorMin = "0.025 0.29", AnchorMax = "0.975 0.96" } }
                , card, card + ".Image");

                AddText(container, card + ".Image", product.Title, 18, TextAnchor.MiddleCenter,
                    config.GreenColor, "0.05 0.05", "0.95 0.95", "ProductImagePlaceholder");

                AddText(container, card, product.Title, 15, TextAnchor.MiddleLeft,
                    config.TextColor, "0.045 0.17", "0.58 0.28", "ProductName");
                if (!string.IsNullOrEmpty(product.Description))
                    AddText(container, card, product.Description, 9, TextAnchor.MiddleLeft,
                        config.SecondaryTextColor, "0.045 0.08", "0.65 0.17", "ProductDescription");
                AddText(container, card, GetShopDurationLabel(player, product), 13, TextAnchor.UpperRight,
                    config.GreenColor, "0.80 0.82", "0.96 0.96", "ProductDuration");
                AddText(container, card, product.Price.ToString(CultureInfo.InvariantCulture) + " ₽", 13, TextAnchor.MiddleRight,
                    config.GreenColor, "0.50 0.08", "0.65 0.18", "ProductPrice");

                // Для КОПТЕРА таймер повторной покупки полностью отключён.
                // Для остальных товаров сохраняется существующая логика ограничений.
                long shopCooldown = GetShopRemainingCooldown(player, product);
                if (shopCooldown > 0L)
                {
                    AddShopCountdown(container, card, shopCooldown);
                }
                else
                {
                    container.Add(new CuiButton
                    {
                        Button =
                        {
                            Command = "infomenu.shop buy " + i,
                            Color = ParseColor(config.GreenColor),
                            HighlightedColor = ParseColor(config.ButtonHoverColor)
                        },
                        Text =
                        {
                            Text = "КУПИТЬ",
                            Font = config.Font,
                            FontSize = 11,
                            Align = TextAnchor.MiddleCenter,
                            Color = "0.02 0.04 0.02 1"
                        },
                        RectTransform = { AnchorMin = "0.69 0.08", AnchorMax = "0.95 0.25" }
                    }, card);
                }
            }

            AddText(container, shopLayer,
                "КУПИТЬ — списание баланса GameStores и выдача товара по его категории.",
                9, TextAnchor.MiddleLeft, config.SecondaryTextColor,
                "0.025 0.015", "0.975 0.06", "ShopFooter");

            CuiHelper.AddUi(player, container);
        }

