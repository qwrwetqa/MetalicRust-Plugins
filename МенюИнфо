        private bool TryGetKitUsageInfo(BasePlayer player, IQKitEntry kit, out int kitType, out int usedAmount, out int maxAmount)
        {
            kitType = 0;
            usedAmount = 0;
            maxAmount = 0;

            Plugin iq = GetIQKitsPlugin();
            if (iq == null || player == null || kit == null)
                return false;

            try
            {
                object iqConfig = GetReflectionMember(iq, "config");
                object categories = GetReflectionMember(iqConfig, "categoryKits");
                object categoryInfo = null;

                foreach (var entry in EnumerateDictionary(categories))
                {
                    if (entry.Key != null &&
                        string.Equals(entry.Key.ToString(), kit.Category, StringComparison.OrdinalIgnoreCase))
                    {
                        categoryInfo = entry.Value;
                        break;
                    }
                }

                object kitList = GetReflectionMember(categoryInfo, "kitList");
                object kitInfo = null;

                foreach (var entry in EnumerateDictionary(kitList))
                {
                    if (entry.Key != null &&
                        string.Equals(entry.Key.ToString(), kit.Key, StringComparison.OrdinalIgnoreCase))
                    {
                        kitInfo = entry.Value;
                        break;
                    }
                }

                if (kitInfo == null)
                    return false;

                kitType = GetReflectionInt(kitInfo, "type", 0);
                maxAmount = Mathf.Max(0, GetReflectionInt(kitInfo, "amount", 0));

                object repository = GetReflectionMember(iq, "repositoryKits");
                object playerRepository = null;
                foreach (var entry in EnumerateDictionary(repository))
                {
                    if (entry.Key != null &&
                        string.Equals(entry.Key.ToString(), player.UserIDString, StringComparison.OrdinalIgnoreCase))
                    {
                        playerRepository = entry.Value;
                        break;
                    }
                }

                object categoryRepository = null;
                foreach (var entry in EnumerateDictionary(playerRepository))
                {
                    if (entry.Key != null &&
                        string.Equals(entry.Key.ToString(), kit.Category, StringComparison.OrdinalIgnoreCase))
                    {
                        categoryRepository = entry.Value;
                        break;
                    }
                }

                object playerKitsTaked = GetReflectionMember(categoryRepository, "playerKitsTaked");
                object playerKitInfo = null;
                foreach (var entry in EnumerateDictionary(playerKitsTaked))
                {
                    if (entry.Key != null &&
                        string.Equals(entry.Key.ToString(), kit.Key, StringComparison.OrdinalIgnoreCase))
                    {
                        playerKitInfo = entry.Value;
                        break;
                    }
                }

                if (playerKitInfo != null)
                    usedAmount = Mathf.Max(0, GetReflectionInt(playerKitInfo, "amount", 0));

                return true;
            }
            catch (Exception ex)
            {
                PrintWarning("[InfoMenu] Ошибка получения лимита выдач IQKits: " + ex.Message);
                return false;
            }
        }

