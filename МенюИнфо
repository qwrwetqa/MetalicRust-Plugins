        protected override void LoadConfig()
        {
            base.LoadConfig();

            try
            {
                config = Config.ReadObject<PluginConfig>();
            }
            catch
            {
                PrintWarning("Config is invalid. Creating a new default configuration.");
                LoadDefaultConfig();
                return;
            }

            if (config == null)
                config = PluginConfig.DefaultConfig();

            if (config.Commands == null || config.Commands.Count == 0)
                config.Commands = new List<string> { "info", "menu", "help" };

            if (config.SideButtons == null || config.SideButtons.Count == 0)
                config.SideButtons = PluginConfig.DefaultConfig().SideButtons;

            if (config.TopTabs == null || config.TopTabs.Count == 0)
                config.TopTabs = PluginConfig.DefaultConfig().TopTabs;

            if (config.SideButtons.Any(x => x == null || string.IsNullOrWhiteSpace(x.Title) || string.IsNullOrWhiteSpace(x.Command)))
                config.SideButtons = PluginConfig.DefaultConfig().SideButtons;

            if (config.TopTabs.Any(x => x == null || string.IsNullOrWhiteSpace(x.Title) || string.IsNullOrWhiteSpace(x.Key)))
                config.TopTabs = PluginConfig.DefaultConfig().TopTabs;

            if (config.Chat == null)
                config.Chat = ChatSettings.Default();

            // В меню доступны только три префикса: VIP, PREMIUM и ELITE.
            config.Chat.Prefixes = ChatSettings.Default().Prefixes;
            if (config.Chat.Ranks == null || config.Chat.Ranks.Count == 0)
                config.Chat.Ranks = ChatSettings.Default().Ranks;
            // Фиксированный набор из 5 цветов, согласованный для меню цветов.
            // Не оставляем старые значения из предыдущей версии конфига.
            config.Chat.NameColors = new List<ChatColorOption>
            {
                new ChatColorOption("#00D9FF"),
                new ChatColorOption("#FFD21F"),
                new ChatColorOption("#A855F7"),
                new ChatColorOption("#22D3EE"),
                new ChatColorOption("#9CA3AF")
            };
            config.Chat.MessageColors = new List<ChatColorOption>
            {
                new ChatColorOption("#00D9FF"),
                new ChatColorOption("#FFD21F"),
                new ChatColorOption("#A855F7"),
                new ChatColorOption("#22D3EE"),
                new ChatColorOption("#9CA3AF")
