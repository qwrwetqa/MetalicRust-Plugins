                        FontSize = 16,
                        Align = TextAnchor.MiddleCenter,
                        Color = allowed && selected ? ParseColor(config.GreenColor) : "1 1 1 1"
                    },
                    RectTransform =
                    {
                        AnchorMin = $"{x:0.###} 0.545",
                        AnchorMax = $"{(x + width):0.###} 0.605"
                    }
                }, content, buttonName);

                // Заблокированный цвет: маленький красный X.
                // Это обычный текст из ASCII и не зависит от emoji/шрифта.
                if (!allowed && config.Chat.ShowLocked)
                {
                    c.Add(new CuiLabel
                    {
                        Text = { Text = "X", Font = config.Font, FontSize = 13, Align = TextAnchor.MiddleCenter, Color = "1 0.12 0.12 1", FadeIn = 0.12f },
                        RectTransform = { AnchorMin = "0 0", AnchorMax = "1 1" }
                    }, buttonName, buttonName + ".LockedX");
                }
            }
        }

        private string HexToCui(string hex)
        {
            if (string.IsNullOrEmpty(hex)) return "1 1 1 1";
            hex = hex.Trim().TrimStart('#');
            if (hex.Length != 6) return "1 1 1 1";
            try
            {
                float r = int.Parse(hex.Substring(0, 2), NumberStyles.HexNumber) / 255f;
                float g = int.Parse(hex.Substring(2, 2), NumberStyles.HexNumber) / 255f;
                float b = int.Parse(hex.Substring(4, 2), NumberStyles.HexNumber) / 255f;
                return string.Format(CultureInfo.InvariantCulture, "{0:0.###} {1:0.###} {2:0.###} 1", r, g, b);
            }
            catch { return "1 1 1 1"; }
        }

