        private void DrawColorButtons(CuiElementContainer c, string content, List<ChatColorOption> colors, string commandPrefix, float left, float right)
        {
            if (colors == null || colors.Count == 0) return;

            int colorCount = Mathf.Min(colors.Count, 5);

            BasePlayer player = BasePlayer.FindByID(_currentChatPlayerId);
            int tierLevel = GetPlayerTierLevel(player);
            bool nameColor = commandPrefix.IndexOf("namecolor", StringComparison.OrdinalIgnoreCase) >= 0;
            PlayerData playerData = GetPlayerData(player);
            string selectedHex = nameColor ? (playerData == null ? "" : playerData.NameColorHex) : (playerData == null ? "" : playerData.MessageColorHex);

            float gap = 0.012f;
            float width = (right - left - gap * (colorCount - 1)) / colorCount;

            for (int i = 0; i < colorCount; i++)
            {
                string hex = colors[i] != null && !string.IsNullOrEmpty(colors[i].Hex) ? colors[i].Hex : "#FFFFFF";
                int required = GetColorRequiredTier(i);
                bool allowed = tierLevel >= required;
                bool selected = string.Equals(hex, selectedHex, StringComparison.OrdinalIgnoreCase);
                float x = left + i * (width + gap);
                string buttonName = content + ".ColorButton." + (nameColor ? "Name" : "Message") + "." + i;

                c.Add(new CuiButton
                {
                    Button =
                    {
                        Command = allowed ? commandPrefix + hex : "",
                        Color = HexToCui(hex),
