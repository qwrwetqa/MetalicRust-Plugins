        private object GetReflectionMember(object instance, string memberName)
        {
            if (instance == null || string.IsNullOrEmpty(memberName))
                return null;

            Type type = instance.GetType();
            const BindingFlags flags = BindingFlags.Instance | BindingFlags.Static |
                                       BindingFlags.Public | BindingFlags.NonPublic |
                                       BindingFlags.FlattenHierarchy;

            while (type != null)
            {
                FieldInfo field = type.GetField(memberName, flags);
                if (field == null)
                    field = type.GetField(memberName, flags | BindingFlags.IgnoreCase);

                if (field != null)
                {
                    try
                    {
                        return field.GetValue(field.IsStatic ? null : instance);
                    }
                    catch { }
                }

                PropertyInfo property = type.GetProperty(memberName, flags);
                if (property == null)
                    property = type.GetProperty(memberName, flags | BindingFlags.IgnoreCase);

                if (property != null && property.GetIndexParameters().Length == 0)
                {
                    try
                    {
                        MethodInfo getter = property.GetGetMethod(true);
                        if (getter != null)
                            return property.GetValue(getter.IsStatic ? null : instance, null);
                    }
                    catch { }
                }

                type = type.BaseType;
            }

            return null;
        }

        private string GetReflectionString(object instance, string memberName, string fallback = "")
        {
            object value = GetReflectionMember(instance, memberName);
            return value == null ? fallback : value.ToString();
        }

        private bool GetReflectionBool(object instance, string memberName, bool fallback = false)
        {
            object value = GetReflectionMember(instance, memberName);
            if (value == null)
                return fallback;

            try { return Convert.ToBoolean(value, CultureInfo.InvariantCulture); }
            catch { return fallback; }
        }

        private bool TryConvertDouble(object value, out double result)
        {
            result = 0.0;
            if (value == null)
                return false;

            try
            {
                result = Convert.ToDouble(value, CultureInfo.InvariantCulture);
                return !double.IsNaN(result) && !double.IsInfinity(result);
            }
            catch { return false; }
        }

        private IEnumerable<KeyValuePair<object, object>> EnumerateDictionary(object value)
        {
            var dictionary = value as System.Collections.IDictionary;
            if (dictionary != null)
            {
                foreach (System.Collections.DictionaryEntry entry in dictionary)
                    yield return new KeyValuePair<object, object>(entry.Key, entry.Value);
                yield break;
            }

            var enumerable = value as System.Collections.IEnumerable;
            if (enumerable == null)
                yield break;

            foreach (object item in enumerable)
            {
                if (item == null)
                    continue;

                object key = GetReflectionMember(item, "Key");
                object val = GetReflectionMember(item, "Value");
                if (key != null)
                    yield return new KeyValuePair<object, object>(key, val);
            }
        }

        private bool HasIQKitPermissions(BasePlayer player, object kitInfo)
        {
            if (player == null || kitInfo == null)
                return false;

            object permissionsObject = GetReflectionMember(kitInfo, "additionalPermissions");
            var permissions = permissionsObject as System.Collections.IEnumerable;
            if (permissions == null)
                return true;

            bool hasPermissionEntries = false;
            foreach (object item in permissions)
            {
                string permissionName = item == null ? string.Empty : item.ToString();
                if (string.IsNullOrWhiteSpace(permissionName))
                    continue;

                hasPermissionEntries = true;
                if (!permission.UserHasPermission(player.UserIDString, permissionName))
                    return false;
            }

            return true;
        }

        private string GetIQKitLanguageText(object languageText, string fallback)
        {
            if (languageText == null)
                return fallback;

            string russian = GetReflectionString(languageText, "russianText");
            if (!string.IsNullOrWhiteSpace(russian))
                return russian;

            string english = GetReflectionString(languageText, "englishText");
            if (!string.IsNullOrWhiteSpace(english))
                return english;

            string text = languageText.ToString();
            return string.IsNullOrWhiteSpace(text) ? fallback : text;
        }

        private List<IQKitEntry> GetIQKits(BasePlayer player)
        {
            var result = new List<IQKitEntry>();
            Plugin iq = GetIQKitsPlugin();

            if (iq == null || player == null)
                return result;

            try
            {
                object iqConfig = GetReflectionMember(iq, "config");
                object categoryObject = GetReflectionMember(iqConfig, "categoryKits");

                if (categoryObject == null)
                {
                    PrintWarning("[InfoMenu] IQKits: не найдено поле categoryKits в конфигурации.");
                    return result;
                }

                bool sortedPermissions = GetReflectionBool(iqConfig, "sortedPermissions", false);
                var privileged = new List<IQKitEntry>();
                var normal = new List<IQKitEntry>();

                foreach (var categoryEntry in EnumerateDictionary(categoryObject))
                {
                    string categoryKey = categoryEntry.Key == null ? string.Empty : categoryEntry.Key.ToString();
                    object categoryInfo = categoryEntry.Value;
                    if (string.IsNullOrWhiteSpace(categoryKey) || categoryInfo == null)
                        continue;

                    bool hideCategoryPermission = GetReflectionBool(categoryInfo, "hideCategoryPermission", false);
                    string categoryPermission = GetReflectionString(categoryInfo, "permission");
                    bool categoryAllowed = string.IsNullOrWhiteSpace(categoryPermission) ||
                                           permission.UserHasPermission(player.UserIDString, categoryPermission);

                    // hideCategoryPermission = true -> категория действительно скрывается без права.
                    // false -> категория и ВСЕ её киты остаются видимыми, даже если конкретный кит закрыт правом.
                    if (hideCategoryPermission && !categoryAllowed)
                        continue;

                    string categoryTitle = GetIQKitLanguageText(
                        GetReflectionMember(categoryInfo, "title"), categoryKey);

                    object kitList = GetReflectionMember(categoryInfo, "kitList");
                    if (kitList == null)
                        continue;

                    foreach (var kitEntry in EnumerateDictionary(kitList))
                    {
                        string kitKey = kitEntry.Key == null ? string.Empty : kitEntry.Key.ToString();
                        object kitInfo = kitEntry.Value;
                        if (string.IsNullOrWhiteSpace(kitKey) || kitInfo == null)
                            continue;

                        bool kitAllowed = HasIQKitPermissions(player, kitInfo);

                        string kitTitle = GetIQKitLanguageText(
                            GetReflectionMember(kitInfo, "title"), kitKey);

                        var entry = new IQKitEntry(
                            categoryKey,
                            categoryTitle,
                            kitKey,
                            kitTitle,
                            categoryAllowed,
                            kitAllowed);

                        bool privilegedCategory = !string.IsNullOrWhiteSpace(categoryPermission) && categoryAllowed;
                        if (sortedPermissions && privilegedCategory)
                            privileged.Add(entry);
                        else
                            normal.Add(entry);
                    }
                }

                if (sortedPermissions)
                    result.AddRange(privileged);
                result.AddRange(normal);

                // КОПТЕР: после покупки w5 должен отображаться в КИТАХ
                // даже если категория/фильтр IQKits скрывает закрытые наборы.
                bool copterAccess = permission.UserHasPermission(player.UserIDString, "iqkits.w5");
                PlayerData copterPlayerData = GetPlayerData(player);
                copterAccess = copterAccess || (copterPlayerData != null && copterPlayerData.PendingCopterKit);

                if (copterAccess && !result.Exists(x => IsCopterKitKey(x.Key)))
                {
                    foreach (var categoryEntry in EnumerateDictionary(categoryObject))
                    {
                        string categoryKey = categoryEntry.Key == null ? string.Empty : categoryEntry.Key.ToString();
                        object categoryInfo = categoryEntry.Value;
                        if (string.IsNullOrWhiteSpace(categoryKey) || categoryInfo == null)
                            continue;

                        object kitList = GetReflectionMember(categoryInfo, "kitList");
                        if (kitList == null)
                            continue;

                        foreach (var kitEntry in EnumerateDictionary(kitList))
                        {
                            string kitKey = kitEntry.Key == null ? string.Empty : kitEntry.Key.ToString();
                            if (!IsCopterKitKey(kitKey))
                                continue;

                            object kitInfo = kitEntry.Value;
                            if (kitInfo == null)
                                break;

                            string categoryTitle = GetIQKitLanguageText(GetReflectionMember(categoryInfo, "title"), categoryKey);
                            string kitTitle = GetIQKitLanguageText(GetReflectionMember(kitInfo, "title"), kitKey);
                            result.Add(new IQKitEntry(categoryKey, categoryTitle, kitKey, kitTitle, true, true));
                            break;
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                PrintError("[InfoMenu] Ошибка чтения IQKits 2.6.7: " + ex);
            }

            return result;
        }

        private string GetKitStatusKey(string category, string key)
        {
            return (category ?? string.Empty) + "::" + (key ?? string.Empty);
        }

