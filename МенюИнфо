        private void RegisterGather(BasePlayer player, Item item)
        {
            if (player == null || item == null) return;
            PlayerData data = GetPlayerData(player);
            if (data == null) return;

            double amount = Math.Max(0d, item.amount);
            if (amount <= 0d) return;

            string shortname = item.info != null ? item.info.shortname ?? "" : "";
            bool ore = IsTrackedOre(shortname);

            data.TotalGathered += amount;
            if (ore) data.OreGathered += amount;
            data.FarmEvents += 1d;

            long now = CurrentUnix();
            if (data.LastGatherUnix > 0 && now - data.LastGatherUnix <= config.RankProgress.FrequentFarmWindowSeconds)
                data.FrequentFarmEvents += 1d;
            data.LastGatherUnix = now;
            data.LastActiveUnix = now;

            ApplyAutoRank(player, false);
            SaveData();
        }

        private bool IsTrackedOre(string shortname)
        {
            if (string.IsNullOrEmpty(shortname)) return false;
            return shortname.Equals("metal.ore", StringComparison.OrdinalIgnoreCase)
                || shortname.Equals("sulfur.ore", StringComparison.OrdinalIgnoreCase)
                || shortname.Equals("hq.metal.ore", StringComparison.OrdinalIgnoreCase)
                || shortname.EndsWith(".ore", StringComparison.OrdinalIgnoreCase);
        }

        private RankProgress GetRankProgress(BasePlayer player)
        {
            PlayerData data = GetPlayerData(player);
            RankProgressSettings settings = config.RankProgress ?? RankProgressSettings.Default();
            double timePercent = settings.HoursFor100Time <= 0d ? 100d : Mathf.Clamp((float)(data.ActiveSeconds / 3600d / settings.HoursFor100Time * 100d), 0f, 100f);
            double farmPercent = settings.OreFor100Farm <= 0d ? 100d : Mathf.Clamp((float)(data.OreGathered / settings.OreFor100Farm * 100d), 0f, 100f);
            double activityPercent = settings.FarmEventsFor100Activity <= 0d ? 100d : Mathf.Clamp((float)(data.FrequentFarmEvents / settings.FarmEventsFor100Activity * 100d), 0f, 100f);
            double weightTotal = Math.Max(1d, settings.TimeWeight + settings.FarmWeight + settings.ActivityWeight);
            double overall = Math.Max(0d, Math.Min(100d, (timePercent * settings.TimeWeight + farmPercent * settings.FarmWeight + activityPercent * settings.ActivityWeight) / weightTotal));
            string purchasedRank = GetPurchasedRank(player);
            string purchasedGroup = GetPurchasedTier(player);
            return new RankProgress
            {
                TimePercent = timePercent, FarmPercent = farmPercent, ActivityPercent = activityPercent, Overall = overall,
                RankGroup = purchasedGroup, RankTitle = purchasedRank, OreGathered = data.OreGathered, ActiveSeconds = data.ActiveSeconds
            };
        }

        private void ApplyAutoRank(BasePlayer player, bool notify)
        {
            if (player == null)
                return;

            // Время и фарм используются только для трёх шкал условий.
            // Сам ранг всегда определяется купленным статусом.
            SyncPurchasedStatus(player, notify);
        }

        private long CurrentUnix()
        {
            return (long)(DateTime.UtcNow - new DateTime(1970, 1, 1)).TotalSeconds;
        }

        private string FormatAmount(double value)
        {
            if (value >= 1000000d) return (value / 1000000d).ToString("0.##", CultureInfo.InvariantCulture) + "M";
            if (value >= 1000d) return (value / 1000d).ToString("0.##", CultureInfo.InvariantCulture) + "K";
            return Math.Round(value).ToString("0", CultureInfo.InvariantCulture);
        }

        private string FormatPlayTime(double seconds)
        {
            TimeSpan t = TimeSpan.FromSeconds(Math.Max(0d, seconds));
            if (t.TotalDays >= 1d) return string.Format(CultureInfo.InvariantCulture, "{0}д {1}ч", (int)t.TotalDays, t.Hours);
            return string.Format(CultureInfo.InvariantCulture, "{0}ч {1}м", (int)t.TotalHours, t.Minutes);
        }

