        private void RequestGameStoreBalance(BasePlayer player, string shopLayer)
        {
            if (player == null || !player.IsConnected)
                return;

            Plugin plugin = GameStoresRUST;
            if (plugin == null)
                plugin = plugins.Find("GameStoresRUST");

            if (plugin == null)
            {
                UpdateGameStoreBalanceText(player, shopLayer, "БАЛАНС: GAMESTORES НЕ НАЙДЕН");
                return;
            }

            try
            {
                MethodInfo method = plugin.GetType().GetMethod(
                    "API_GetPlayerBalance",
                    BindingFlags.Instance | BindingFlags.NonPublic);

                if (method == null)
                {
                    UpdateGameStoreBalanceText(player, shopLayer, "БАЛАНС: API НЕ НАЙДЕН");
                    return;
                }

                Action<bool, string> callback = (success, value) =>
                {
                    if (player == null || !player.IsConnected)
                        return;

                    if (success)
                        UpdateGameStoreBalanceText(player, shopLayer, "БАЛАНС: " + value + " ₽");
                    else
                        UpdateGameStoreBalanceText(player, shopLayer, "БАЛАНС: ОШИБКА");
                };

                // В этой версии Rust BasePlayer.userID внутри плагина имеет тип EncryptedValue<ulong>.
                // Reflection не умеет автоматически привести его к ulong, который ожидает GameStoresRUST.
                // Берём обычную строку SteamID и явно преобразуем её в ulong.
                ulong steamId;
                if (!ulong.TryParse(player.UserIDString, out steamId) || steamId == 0)
                {
                    UpdateGameStoreBalanceText(player, shopLayer, "БАЛАНС: STEAMID ОШИБКА");
                    return;
                }

                // В GameStores передаём именно SteamID текущего игрока.
                PrintWarning("[InfoMenu] GameStores balance request: SteamID " + steamId.ToString(CultureInfo.InvariantCulture));
                method.Invoke(plugin, new object[] { steamId, callback });
            }
            catch (Exception ex)
            {
                PrintWarning("[InfoMenu] Ошибка получения баланса GameStoresRUST: " + ex.Message);
                UpdateGameStoreBalanceText(player, shopLayer, "БАЛАНС: ОШИБКА");
            }
        }

