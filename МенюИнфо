        private void EnsureRankTracking(BasePlayer player)
        {
            if (player == null) return;
            PlayerData data = GetPlayerData(player);
            if (data == null) return;
            if (data.LastActiveUnix <= 0)
                data.LastActiveUnix = CurrentUnix();
            if (string.IsNullOrEmpty(data.AutoRank))
                data.AutoRank = "cap";
            ApplyAutoRank(player, false);
        }

        private void UpdateActiveTimeAndRanks()
        {
            long now = CurrentUnix();
            foreach (BasePlayer player in BasePlayer.activePlayerList.ToList())
            {
                if (player == null || !player.IsConnected) continue;
                PlayerData data = GetPlayerData(player);
                if (data == null) continue;

                long last = data.LastActiveUnix;
                if (last <= 0 || now <= last || now - last > 300)
                    last = now - 60;

                double delta = Math.Min(120d, Math.Max(0d, now - last));
                data.ActiveSeconds += delta;
                data.LastActiveUnix = now;
                ApplyAutoRank(player, false);
            }
            SaveData();
        }

