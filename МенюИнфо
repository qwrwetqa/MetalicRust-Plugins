        private string GetPurchasedTier(BasePlayer player)
        {
            if (player == null)
                return string.Empty;

            // Сначала учитываем новые сроки покупок. Приоритет: ELITE > PREMIUM > VIP.
            long now = CurrentUnix();
            if (GetTierExpiry(player, "elite") > now) return "ELITE";
            if (GetTierExpiry(player, "premium") > now) return "PREMIUM";
            if (GetTierExpiry(player, "vip") > now) return "VIP";

            // Группа BetterChat/oxide сама по себе НЕ считается покупкой.
            // VIP/PREMIUM/ELITE активируются только после покупки в магазине.
            return string.Empty;
        }

        private long GetTierExpiry(BasePlayer player, string tier)
        {
            if (player == null || string.IsNullOrEmpty(tier))
                return 0;

            PlayerData data = GetPlayerData(player);
            if (data == null)
                return 0;

            switch (tier.ToLowerInvariant())
            {
                case "vip": return data.VipExpiresAt;
                case "premium": return data.PremiumExpiresAt;
                case "elite": return data.EliteExpiresAt;
            }
            return 0;
        }

        private void SetTierExpiry(BasePlayer player, string tier, long value)
        {
            PlayerData data = GetPlayerData(player);
            if (data == null) return;

            switch (tier.ToLowerInvariant())
            {
                case "vip": data.VipExpiresAt = value; break;
                case "premium": data.PremiumExpiresAt = value; break;
                case "elite": data.EliteExpiresAt = value; break;
            }
            SaveData();
        }

        private void AddTierDays(BasePlayer player, string tier, int days)
        {
            if (player == null || string.IsNullOrEmpty(tier) || days <= 0)
                return;

            long now = CurrentUnix();
            long current = GetTierExpiry(player, tier);
            long baseTime = current > now ? current : now;
            SetTierExpiry(player, tier, baseTime + days * 86400L);
        }

        private int GetPlayerTierLevel(BasePlayer player)
        {
            if (player == null)
                return 0;

            string tier = GetPurchasedTier(player);
            if (string.Equals(tier, "ELITE", StringComparison.OrdinalIgnoreCase)) return 3;
            if (string.Equals(tier, "PREMIUM", StringComparison.OrdinalIgnoreCase)) return 2;
            if (string.Equals(tier, "VIP", StringComparison.OrdinalIgnoreCase)) return 1;
            return 0;
        }

        private int GetColorRequiredTier(int index)
        {
            if (index <= 0) return 0;
            if (index == 1) return 1;
            if (index == 2) return 2;
            return 3;
        }

        private bool HasPurchasedStatus(BasePlayer player, string status)
        {
            if (player == null || string.IsNullOrEmpty(status))
                return false;

            if (HasChatGroup(player, status))
                return true;

            try
            {
                if (permission.UserHasGroup(player.UserIDString, status))
                    return true;
            }
            catch { }

            try
            {
                if (permission.UserHasPermission(player.UserIDString, status))
                    return true;
            }
            catch { }

            try
            {
                if (permission.UserHasPermission(player.UserIDString, "metalicrust." + status))
                    return true;
            }
            catch { }

            return false;
        }

        private void ExpirePurchasedTiers(BasePlayer player)
        {
            if (player == null) return;

            long now = CurrentUnix();
            PlayerData data = GetPlayerData(player);
            if (data == null) return;

            bool changed = false;
            if (data.VipExpiresAt > 0 && data.VipExpiresAt <= now) { data.VipExpiresAt = 0; Server.Command("oxide.usergroup remove " + player.UserIDString + " vip"); changed = true; }
            if (data.PremiumExpiresAt > 0 && data.PremiumExpiresAt <= now) { data.PremiumExpiresAt = 0; Server.Command("oxide.usergroup remove " + player.UserIDString + " premium"); changed = true; }
            if (data.EliteExpiresAt > 0 && data.EliteExpiresAt <= now) { data.EliteExpiresAt = 0; Server.Command("oxide.usergroup remove " + player.UserIDString + " elite"); changed = true; }
            if (changed) SaveData();
        }

        private void SetPurchasedChatGroup(BasePlayer player, string tier)
        {
            if (player == null || string.IsNullOrEmpty(tier))
                return;

            string targetGroup = tier.ToLowerInvariant();
            try
            {
                if (!string.Equals(targetGroup, "vip", StringComparison.OrdinalIgnoreCase))
                    Server.Command("chat", "user", "remove", player.UserIDString, "vip");
                if (!string.Equals(targetGroup, "premium", StringComparison.OrdinalIgnoreCase))
                    Server.Command("chat", "user", "remove", player.UserIDString, "premium");
                if (!string.Equals(targetGroup, "elite", StringComparison.OrdinalIgnoreCase))
                    Server.Command("chat", "user", "remove", player.UserIDString, "elite");

                Server.Command("chat", "user", "add", player.UserIDString, targetGroup);
            }
            catch (Exception ex)
            {
                PrintWarning("[InfoMenu] Не удалось установить группу после покупки " + tier + ": " + ex.Message);
            }
        }

        private void SyncPurchasedStatus(BasePlayer player, bool notify)
        {
            if (player == null || !player.IsConnected)
                return;

            ExpirePurchasedTiers(player);
            string tier = GetPurchasedTier(player);
            if (string.IsNullOrEmpty(tier))
            {
                if (notify)
                {
                    player.ChatMessage("<color=#ff4444>Купленный VIP/PREMIUM/ELITE не найден.</color>");
                    OpenChatPage(player, 0);
                }
                return;
            }


            PlayerData data = GetPlayerData(player);
            string rank = GetPurchasedRank(player);
            bool changed = data != null && !string.Equals(data.AutoRank, rank, StringComparison.OrdinalIgnoreCase);
            if (data != null)
                data.AutoRank = rank;
            if (changed)
                SaveData();

            if (notify)
            {
                player.ChatMessage("<color=#55ff22>Статус: " + tier + " | Ранг: " + rank + "</color>");
                OpenChatPage(player, 0);
            }
        }

