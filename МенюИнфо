        private Dictionary<string, int> CaptureInventory(BasePlayer player)
        {
            var result = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);

            if (player == null || player.inventory == null)
                return result;

            CaptureContainer(player.inventory.containerMain, result);
            CaptureContainer(player.inventory.containerBelt, result);
            CaptureContainer(player.inventory.containerWear, result);

            return result;
        }

        private void CaptureContainer(ItemContainer container, Dictionary<string, int> result)
        {
            if (container == null || container.itemList == null)
                return;

            foreach (Item item in container.itemList)
            {
                if (item == null || item.info == null)
                    continue;

                string key = GetInventoryItemKey(item);
                int amount;
                result.TryGetValue(key, out amount);
                result[key] = amount + Mathf.Max(1, item.amount);
            }
        }

        private string GetInventoryItemKey(Item item)
        {
            if (item == null || item.info == null)
                return "0:0:0";

            bool blueprint = false;
            try
            {
                blueprint = item.IsBlueprint();
            }
            catch
            {
            }

            return string.Format(
                CultureInfo.InvariantCulture,
                "{0}:{1}:{2}",
                item.info.itemid,
                item.skin,
                blueprint ? 1 : 0);
        }

        private bool KitItemsDidNotFit(BasePlayer player, PendingKitTake pending)
        {
            if (player == null || pending == null)
                return false;

            Dictionary<string, int> expected = GetExpectedKitItems(pending.Key);
            if (expected.Count == 0 || pending.InventoryBefore == null)
                return false;

            Dictionary<string, int> after = CaptureInventory(player);

            foreach (KeyValuePair<string, int> pair in expected)
            {
                int before;
                int current;
                pending.InventoryBefore.TryGetValue(pair.Key, out before);
                after.TryGetValue(pair.Key, out current);

                int received = current - before;
                if (received < pair.Value)
                    return true;
            }

            return false;
        }

        private Dictionary<string, int> GetExpectedKitItems(string kitKey)
        {
            var result = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            Plugin iq = GetIQKitsPlugin();

            if (iq == null || string.IsNullOrWhiteSpace(kitKey))
                return result;

            try
            {
                object iqConfig = GetReflectionMember(iq, "config");
                if (iqConfig == null)
                    return result;

                // У IQKits список предметов хранится отдельно от categoryKits.
                // Надёжнее сериализовать его конфигурацию и найти нужный пресет
                // по ключу, чем зависеть от внутренних имён private-полей IQKits.
                string json = JsonConvert.SerializeObject(iqConfig);
                JObject root = JObject.Parse(json);

                JToken presetsRoot = FindJTokenByProperty(root,
                    "Настройка пресетов с предметами [Уникальное название пресета] = Список предметов");

                // На случай изменения текста подписи в будущей версии IQKits
                // ищем также по устойчивой части названия раздела.
                if (presetsRoot == null)
                    presetsRoot = FindJTokenByPropertyContains(root, "Настройка пресетов с предметами");

                if (presetsRoot == null || presetsRoot.Type != JTokenType.Object)
                    return result;

                JToken preset = FindObjectPropertyIgnoreCase(presetsRoot, kitKey);
                if (preset == null || preset.Type != JTokenType.Array)
                    return result;

                foreach (JToken presetItem in preset.Children())
                {
                    if (presetItem == null || presetItem.Type != JTokenType.Object)
                        continue;

                    JToken typeToken = FindPropertyIgnoreCase(presetItem, "Тип предмета : 0 - Физический предмет, 1 - Команда");
                    if (typeToken != null && typeToken.Type != JTokenType.Null && typeToken.ToObject<int>() != 0)
                        continue;

                    JToken physical = FindObjectPropertyByRussianName(presetItem, "Настройка физического предмета");
                    if (physical == null || physical.Type != JTokenType.Object)
                        continue;

                    string shortName = GetJStringByNames(physical, "Shortname", "shortName", "shortname");
                    if (string.IsNullOrWhiteSpace(shortName))
                        continue;

                    ItemDefinition definition = ItemManager.FindItemDefinition(shortName);
                    if (definition == null)
                        continue;

                    int amount = GetJIntByNames(physical, 1, "Количество", "amount");
                    if (amount < 1)
                        amount = 1;

                    ulong skin = GetJULongByNames(physical, 0UL, "SkinID", "skinID", "skinId");
                    bool blueprint = GetJBoolByNames(physical, false, "Blueprint", "blueprint", "isBlueprint");

                    string key = string.Format(
                        CultureInfo.InvariantCulture,
                        "{0}:{1}:{2}",
                        definition.itemid,
                        skin,
                        blueprint ? 1 : 0);

                    int total;
                    result.TryGetValue(key, out total);
                    result[key] = total + amount;
                }
            }
            catch (Exception ex)
            {
                PrintWarning("[InfoMenu] Не удалось прочитать пресет IQKits " + kitKey + ": " + ex.Message);
            }

            return result;
        }

        private JToken FindJTokenByProperty(JToken root, string propertyName)
        {
            if (root == null)
                return null;

            if (root.Type == JTokenType.Object)
            {
                foreach (JProperty property in root.Children<JProperty>())
                {
                    if (string.Equals(property.Name, propertyName, StringComparison.OrdinalIgnoreCase))
                        return property.Value;

                    JToken nested = FindJTokenByProperty(property.Value, propertyName);
                    if (nested != null)
                        return nested;
                }
            }
            else if (root.Type == JTokenType.Array)
            {
                foreach (JToken child in root.Children())
                {
                    JToken nested = FindJTokenByProperty(child, propertyName);
                    if (nested != null)
                        return nested;
                }
            }

            return null;
        }

        private JToken FindJTokenByPropertyContains(JToken root, string text)
        {
            if (root == null || string.IsNullOrEmpty(text))
                return null;

            if (root.Type == JTokenType.Object)
            {
                foreach (JProperty property in root.Children<JProperty>())
                {
                    if (property.Name.IndexOf(text, StringComparison.OrdinalIgnoreCase) >= 0)
                        return property.Value;

                    JToken nested = FindJTokenByPropertyContains(property.Value, text);
                    if (nested != null)
                        return nested;
                }
            }
            else if (root.Type == JTokenType.Array)
            {
                foreach (JToken child in root.Children())
                {
                    JToken nested = FindJTokenByPropertyContains(child, text);
                    if (nested != null)
                        return nested;
                }
            }

            return null;
        }

        private JToken FindObjectPropertyIgnoreCase(JToken objectToken, string propertyName)
        {
            if (objectToken == null || objectToken.Type != JTokenType.Object)
                return null;

            foreach (JProperty property in objectToken.Children<JProperty>())
            {
                if (string.Equals(property.Name, propertyName, StringComparison.OrdinalIgnoreCase))
                    return property.Value;
            }

            return null;
        }

        private JToken FindObjectPropertyByRussianName(JToken objectToken, string propertyName)
        {
            if (objectToken == null || objectToken.Type != JTokenType.Object)
                return null;

            foreach (JProperty property in objectToken.Children<JProperty>())
            {
                if (string.Equals(property.Name, propertyName, StringComparison.OrdinalIgnoreCase))
                    return property.Value;
            }

            return null;
        }

        private JToken FindPropertyIgnoreCase(JToken objectToken, string propertyName)
        {
            return FindObjectPropertyIgnoreCase(objectToken, propertyName);
        }

        private string GetJStringByNames(JToken token, params string[] names)
        {
            if (token == null)
                return string.Empty;

            foreach (string name in names)
            {
                JToken value = FindPropertyIgnoreCase(token, name);
                if (value == null || value.Type == JTokenType.Null)
                    continue;

                string text = value.ToString();
                if (!string.IsNullOrWhiteSpace(text))
                    return text;
            }

            return string.Empty;
        }

        private int GetJIntByNames(JToken token, int fallback, params string[] names)
        {
            string text = GetJStringByNames(token, names);
            int value;
            return int.TryParse(text, NumberStyles.Integer, CultureInfo.InvariantCulture, out value) ? value : fallback;
        }

        private ulong GetJULongByNames(JToken token, ulong fallback, params string[] names)
        {
            string text = GetJStringByNames(token, names);
            ulong value;
            return ulong.TryParse(text, NumberStyles.Integer, CultureInfo.InvariantCulture, out value) ? value : fallback;
        }

        private bool GetJBoolByNames(JToken token, bool fallback, params string[] names)
        {
            string text = GetJStringByNames(token, names);
            bool value;
            return bool.TryParse(text, out value) ? value : fallback;
        }

        private int GetReflectionInt(object instance, string memberName, int fallback)
        {
            object value = GetReflectionMember(instance, memberName);
            if (value == null)
                return fallback;

            try
            {
                return Convert.ToInt32(value, CultureInfo.InvariantCulture);
            }
            catch
            {
                return fallback;
            }
        }

        private ulong GetReflectionULong(object instance, string memberName, ulong fallback)
        {
            object value = GetReflectionMember(instance, memberName);
            if (value == null)
                return fallback;

            try
            {
                return Convert.ToUInt64(value, CultureInfo.InvariantCulture);
            }
            catch
            {
                return fallback;
            }
        }

        private IEnumerable<object> EnumerateValues(object value)
        {
            if (value == null)
                yield break;

            var dictionary = value as System.Collections.IDictionary;
            if (dictionary != null)
            {
                foreach (System.Collections.DictionaryEntry entry in dictionary)
                    yield return entry.Value;
                yield break;
            }

            var enumerable = value as System.Collections.IEnumerable;
            if (enumerable == null || value is string)
                yield break;

            foreach (object item in enumerable)
                yield return item;
        }

        private object FindPresetItems(object current, string kitKey, int depth, HashSet<object> visited)
        {
            if (current == null || depth > 5 || current is string)
                return null;

            Type currentType = current.GetType();
            if (!currentType.IsValueType)
            {
                if (visited.Contains(current))
                    return null;
                visited.Add(current);
            }

            var dictionary = current as System.Collections.IDictionary;
            if (dictionary != null)
            {
                foreach (System.Collections.DictionaryEntry entry in dictionary)
                {
                    if (entry.Key != null &&
                        string.Equals(entry.Key.ToString(), kitKey, StringComparison.OrdinalIgnoreCase))
                    {
                        object value = entry.Value;
                        if (value is System.Collections.IEnumerable && !(value is string))
                            return value;
                    }
                }

                foreach (System.Collections.DictionaryEntry entry in dictionary)
                {
                    object found = FindPresetItems(entry.Value, kitKey, depth + 1, visited);
                    if (found != null)
                        return found;
                }

                return null;
            }

            var enumerable = current as System.Collections.IEnumerable;
            if (enumerable != null)
            {
                foreach (object item in enumerable)
                {
                    object found = FindPresetItems(item, kitKey, depth + 1, visited);
                    if (found != null)
                        return found;
                }

                return null;
            }

            foreach (FieldInfo field in currentType.GetFields(
                BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic))
            {
                if (field.FieldType == typeof(string) || field.FieldType.IsPrimitive)
                    continue;

                object fieldValue;
                try
                {
                    fieldValue = field.GetValue(current);
                }
                catch
                {
                    continue;
                }

                object found = FindPresetItems(fieldValue, kitKey, depth + 1, visited);
                if (found != null)
                    return found;
            }

            return null;
        }

        private void ShowKitInventoryFull(BasePlayer player, int page)
        {
            if (player == null || !player.IsConnected)
                return;

            // Состояние "ИНВЕНТАРЬ ПОЛОН" рисуется прямо в OpenKitsPage,
            // поэтому никаких дополнительных кнопок сайта или наложений не создаём.
            OpenKitsPage(player, page);

            // Через несколько секунд убираем временное сообщение, чтобы после него
            // снова отображался обычный cooldown/лимит набора.
            string kitKey;
            if (!lastInventoryFullKit.TryGetValue(player.userID, out kitKey))
                return;

            timer.Once(3f, () =>
            {
                if (player == null || !player.IsConnected)
                    return;

                string currentKey;
                if (!lastInventoryFullKit.TryGetValue(player.userID, out currentKey))
                    return;

                if (!string.Equals(currentKey, kitKey, StringComparison.OrdinalIgnoreCase))
                    return;

                lastInventoryFullKit.Remove(player.userID);

                int currentPage;
                if (!openKitPages.TryGetValue(player.userID, out currentPage))
                    currentPage = page;

                OpenKitsPage(player, currentPage);
            });
        }

        private void RevokeCopterPermissionAfterClaim(BasePlayer player)
        {
            if (player == null)
                return;

            PlayerData copterData = GetPlayerData(player);
            bool hasCopterPermission = permission.UserHasPermission(player.UserIDString, "iqkits.w5");
            bool hasPendingPurchase = copterData != null && copterData.PendingCopterKit;

            if (!hasCopterPermission && !hasPendingPurchase)
                return;

            if (hasCopterPermission)
                permission.RevokeUserPermission(player.UserIDString, "iqkits.w5");

            if (copterData != null)
                copterData.PendingCopterKit = false;

            SaveData();
        }

        private void OnKitRedeemed(BasePlayer player, string kitKey)
        {
            if (player == null || !player.IsConnected)
                return;

            // КОПТЕР: разрешение выдаётся GameStores и используется один раз.
            // После фактической выдачи IQKits разрешение сразу отзывается.
            // После покупки повторная покупка коптера блокируется на 10 минут.
            if (IsCopterKitKey(kitKey))
            {
                // IQKits вызвал hook после фактической выдачи w5.
                // Снимаем ТОЛЬКО permission коптера, никаких removegroup.
                RevokeCopterPermissionAfterClaim(player);
            }

            PendingKitTake pending;
            if (!pendingKitTakes.TryGetValue(player.userID, out pending))
                return;

            if (!string.Equals(pending.Key, kitKey, StringComparison.OrdinalIgnoreCase))
                return;

            pendingKitTakes.Remove(player.userID);

            string kitId = GetKitStatusKey(pending.Category, pending.Key);
            GetFailedSet(player.userID).Remove(kitId);
            GetRedeemedSet(player.userID).Add(kitId);

            int page = pending.Page;

            // IQKits вызывает OnKitRedeemed сразу после создания/выдачи предметов.
            // Ждём один кадр, чтобы инвентарь уже содержал фактически выданные предметы.
            timer.Once(0.35f, () =>
            {
                if (player == null || !player.IsConnected)
                    return;

                if (KitItemsDidNotFit(player, pending))
                {
                    lastInventoryFullKit[player.userID] = pending.Key;
                    ShowKitInventoryFull(player, page);
                    return;
                }

                lastInventoryFullKit.Remove(player.userID);

                // Permission уже снят в OnKitRedeemed. Перерисовываем КИТЫ
                // после завершения hook, чтобы кнопка ВЗЯТЬ сменилась на МАГАЗИН.
                timer.Once(0.15f, () =>
                {
                    if (player != null && player.IsConnected)
                        OpenKitsPage(player, page);
                });
            });
        }

