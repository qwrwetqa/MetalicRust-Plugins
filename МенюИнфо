        [ConsoleCommand("infomenu.shop")]
        private void ConsoleShop(ConsoleSystem.Arg arg)
        {
            BasePlayer player = arg.Player();
            if (player == null)
                return;

            string action = arg.GetString(0, "");

            if (string.Equals(action, "category", StringComparison.OrdinalIgnoreCase))
            {
                int category = arg.GetInt(1, 0);
                openShopCategories[player.userID] = category;
                OpenShopPage(player);
                return;
            }

            if (string.Equals(action, "balance", StringComparison.OrdinalIgnoreCase))
            {
                OpenShopPage(player);
                return;
            }

            if (string.Equals(action, "topup", StringComparison.OrdinalIgnoreCase))
            {
                OpenGameStoreTopUp(player);
                return;
            }

            if (string.Equals(action, "topupopen", StringComparison.OrdinalIgnoreCase))
            {
                OpenGameStoreTopUpExternal(player);
                return;
            }

            if (string.Equals(action, "topupback", StringComparison.OrdinalIgnoreCase))
            {
                OpenShopPage(player);
                return;
            }

            if (string.Equals(action, "buy", StringComparison.OrdinalIgnoreCase))
            {
                OpenGameStoreProduct(player, arg.GetInt(1, -1));
                return;
            }

            if (string.Equals(action, "confirm", StringComparison.OrdinalIgnoreCase))
            {
                int productIndex;
                if (pendingShopConfirmations.TryGetValue(player.userID, out productIndex))
                {
                    pendingShopConfirmations.Remove(player.userID);
                    CuiHelper.DestroyUi(player, MainLayer + ".ShopConfirm");
                    BeginGameStorePurchase(player, productIndex);
                }
                return;
            }

            if (string.Equals(action, "cancelconfirm", StringComparison.OrdinalIgnoreCase))
            {
                pendingShopConfirmations.Remove(player.userID);
                CuiHelper.DestroyUi(player, MainLayer + ".ShopConfirm");
                OpenShopPage(player);
                return;
            }

            if (string.Equals(action, "take", StringComparison.OrdinalIgnoreCase))
            {
                TakeGameStoreItem(player, arg.GetInt(1, 0));
                return;
            }

            if (string.Equals(action, "refreshcart", StringComparison.OrdinalIgnoreCase))
            {
                RefreshGameStoreCart(player);
                return;
            }

            if (string.Equals(action, "close", StringComparison.OrdinalIgnoreCase))
            {
                DestroyMenu(player);
                return;
            }

            if (string.Equals(action, "tab", StringComparison.OrdinalIgnoreCase))
            {
                string tab = arg.GetString(1, "shop");
                if (string.Equals(tab, "cart", StringComparison.OrdinalIgnoreCase))
                {
                    RefreshGameStoreCart(player);
                    return;
                }
                OpenGameStoreTab(player, tab);
                return;
            }

            int legacyProduct;
            if (int.TryParse(action, out legacyProduct))
            {
                OpenGameStoreProduct(player, legacyProduct);
                return;
            }

            OpenShopPage(player);
        }

        [ConsoleCommand("infomenu.command")]
        private void ConsoleCommandButton(ConsoleSystem.Arg arg)
        {
            var player = arg.Player();

            if (player == null)
                return;

            string command = arg.GetString(0, "");

            if (string.IsNullOrEmpty(command))
                return;

            switch (command.TrimStart('/').ToLowerInvariant())
            {
                case "kit":
                    OpenKitsPage(player, 0);
                    return;
                default:
                    player.SendConsoleCommand("chat.say", "/" + command.TrimStart('/'));
                    return;
            }
        }

