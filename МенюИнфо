        [ConsoleCommand("infomenu.report.send")]
        private void ConsoleReportSend(ConsoleSystem.Arg arg)
        {
            BasePlayer player = arg.Player();
            if (player == null)
                return;

            string target = arg.GetString(0, string.Empty);
            if (string.IsNullOrWhiteSpace(target))
                return;

            target = target.Trim().Trim('"');

            BasePlayer targetPlayer = FindOnlinePlayerForReport(target);
            if (targetPlayer == null || targetPlayer == player)
            {
                player.ChatMessage("<color=#ff4444>Игрок не найден или нельзя пожаловаться на себя.</color>");
                OpenReportPage(player, 0);
                return;
            }

            // Передаём выбранного игрока существующей системе /report.
            // Никакой Telegram-логики в InfoMenu не добавляется.
            player.SendConsoleCommand("chat.say", "/report " + targetPlayer.userID);
            player.ChatMessage("<color=#55ff22>Репорт отправлен на игрока:</color> " + EscapeText(targetPlayer.displayName));
        }

        private BasePlayer FindOnlinePlayerForReport(string value)
        {
            if (string.IsNullOrWhiteSpace(value))
                return null;

            ulong id;
            if (ulong.TryParse(value, out id))
            {
                BasePlayer byId = BasePlayer.FindByID(id);
                if (byId != null && byId.IsConnected)
                    return byId;
            }

            string query = value.Trim();
            BasePlayer exact = BasePlayer.activePlayerList.FirstOrDefault(x =>
                x != null && x.IsConnected &&
                string.Equals(x.displayName, query, StringComparison.OrdinalIgnoreCase));
            if (exact != null)
                return exact;

            return BasePlayer.activePlayerList.FirstOrDefault(x =>
                x != null && x.IsConnected &&
                x.displayName != null &&
                x.displayName.IndexOf(query, StringComparison.OrdinalIgnoreCase) >= 0);
        }

