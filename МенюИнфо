        private string FindIQKitCategory(string kitKey)
        {
            Plugin iq = GetIQKitsPlugin();
            if (iq == null || string.IsNullOrWhiteSpace(kitKey))
                return string.Empty;

            try
            {
                object iqConfig = GetReflectionMember(iq, "config");
                object categoryObject = GetReflectionMember(iqConfig, "categoryKits");
                if (categoryObject == null)
                    return string.Empty;

                foreach (var categoryEntry in EnumerateDictionary(categoryObject))
                {
                    string categoryKey = categoryEntry.Key == null ? string.Empty : categoryEntry.Key.ToString();
                    object categoryInfo = categoryEntry.Value;
                    if (string.IsNullOrWhiteSpace(categoryKey) || categoryInfo == null)
                        continue;

                    object kitList = GetReflectionMember(categoryInfo, "kitList");
                    foreach (var kitEntry in EnumerateDictionary(kitList))
                    {
                        string key = kitEntry.Key == null ? string.Empty : kitEntry.Key.ToString();
                        if (string.Equals(key, kitKey, StringComparison.OrdinalIgnoreCase))
                            return categoryKey;
                    }
                }
            }
            catch (Exception ex)
            {
                PrintWarning("[InfoMenu] Не удалось определить категорию IQKits для " + kitKey + ": " + ex.Message);
            }

            return string.Empty;
        }

        [ConsoleCommand("infomenu.coptertake")]
        private void ConsoleCopterTake(ConsoleSystem.Arg arg)
        {
            BasePlayer player = arg.Player();
            if (player == null || !player.IsConnected)
                return;

            PlayerData copterData = GetPlayerData(player);
            bool hasCopterAccess =
                (copterData != null && copterData.PendingCopterKit) ||
                permission.UserHasPermission(player.UserIDString, "iqkits.w5");

            if (!hasCopterAccess)
                return;

            Plugin iq = GetIQKitsPlugin();
            if (iq == null)
            {
                player.ChatMessage("<color=#ff5555>IQKits ещё не загружен.</color>");
                return;
            }

            // Запоминаем инвентарь ДО выдачи. Это нужно как резервный способ
            // определить успешную выдачу, если конкретная версия IQKits не вызовет
            // OnKitRedeemed. Право iqkits.w5 снимается ТОЛЬКО после успешной выдачи.
            pendingKitTakes[player.userID] = new PendingKitTake
            {
                Category = FindIQKitCategory(CopterKitKey),
                Key = CopterKitKey,
                Page = 0,
                RequestedAt = Time.realtimeSinceStartup,
                InventoryBefore = CaptureInventory(player)
            };

            ConsoleSystem.Run(
                ConsoleSystem.Option.Server,
                "kit",
                "give",
                player.UserIDString,
                CopterKitKey
            );

            // Обычно IQKits вызывает OnKitRedeemed сам. Если нет — проверяем
            // фактически полученные предметы и только после этого снимаем permission.
            timer.Once(1.50f, () =>
            {
                if (player == null || !player.IsConnected)
                    return;

                PendingKitTake pending;
                if (!pendingKitTakes.TryGetValue(player.userID, out pending))
                {
                    OpenKitsPage(player, 0);
                    return;
                }

                Dictionary<string, int> expected = GetExpectedKitItems(CopterKitKey);
                bool successfulClaim = expected.Count > 0 && !KitItemsDidNotFit(player, pending);

                if (successfulClaim)
                {
                    pendingKitTakes.Remove(player.userID);
                    RevokeCopterPermissionAfterClaim(player);
                }
                else
                {
                    pendingKitTakes.Remove(player.userID);
                }

                // После успешного получения обязательно перерисовываем КИТЫ,
                // чтобы вместо ВЗЯТЬ сразу появилась кнопка МАГАЗИН.
                timer.Once(0.15f, () =>
                {
                    if (player != null && player.IsConnected)
                        OpenKitsPage(player, 0);
                });
            });
        }

        [ConsoleCommand("infomenu.kittake")]
        private void ConsoleKitTake(ConsoleSystem.Arg arg)
        {
            BasePlayer player = arg.Player();
            if (player == null)
                return;

            Plugin iq = GetIQKitsPlugin();
            if (iq == null)
                return;

            int index = arg.GetInt(0, -1);
            int page = arg.GetInt(1, 0);
            List<IQKitEntry> kits = GetIQKits(player);
            if (index < 0 || index >= kits.Count)
                return;

            IQKitEntry kit = kits[index];
            if (!kit.IsAllowed)
            {
                OpenKitsPage(player, page);
                return;
            }

            double cooldown = GetKitRemainingCooldown(player, kit);
            if (cooldown > 0.0)
            {
                OpenKitsPage(player, page);
                return;
            }

            string kitId = GetKitStatusKey(kit.Category, kit.Key);
            GetRedeemedSet(player.userID).Remove(kitId);
            GetFailedSet(player.userID).Remove(kitId);
            lastInventoryFullKit.Remove(player.userID);

            pendingKitTakes[player.userID] = new PendingKitTake
            {
                Category = kit.Category,
                Key = kit.Key,
                Page = page,
                RequestedAt = Time.realtimeSinceStartup,
                InventoryBefore = CaptureInventory(player)
            };

            player.SendConsoleCommand("ui_kit_func", "take.kit", kit.Category, kit.Key,
                page.ToString(CultureInfo.InvariantCulture));

            timer.Once(1.50f, () =>
            {
                if (player == null || !player.IsConnected)
                    return;

                PendingKitTake pending;
                if (!pendingKitTakes.TryGetValue(player.userID, out pending))
                    return;

                if (!string.Equals(pending.Category, kit.Category, StringComparison.OrdinalIgnoreCase) ||
                    !string.Equals(pending.Key, kit.Key, StringComparison.OrdinalIgnoreCase))
                    return;

                // Если IQKits не вызвал OnKitRedeemed (или сделал это позже),
                // всё равно проверяем фактическое содержимое инвентаря.
                if (KitItemsDidNotFit(player, pending))
                {
                    pendingKitTakes.Remove(player.userID);
                    lastInventoryFullKit[player.userID] = pending.Key;
                    ShowKitInventoryFull(player, pending.Page);
                    return;
                }

                pendingKitTakes.Remove(player.userID);
                GetFailedSet(player.userID).Add(kitId);
                OpenKitsPage(player, pending.Page);
            });
        }

