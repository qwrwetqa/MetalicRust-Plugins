        }

        private double GetKitRemainingCooldown(BasePlayer player, IQKitEntry kit)
        {
            Plugin iq = GetIQKitsPlugin();
            if (iq == null || player == null || kit == null)
                return 0.0;

            try
            {
                object repository = GetReflectionMember(iq, "repositoryKits");
                object playerRepository = null;

                foreach (var entry in EnumerateDictionary(repository))
                {
                    if (entry.Key != null &&
                        string.Equals(entry.Key.ToString(), player.UserIDString, StringComparison.OrdinalIgnoreCase))
                    {
                        playerRepository = entry.Value;
                        break;
                    }
                }

                object categoryRepository = null;
                foreach (var entry in EnumerateDictionary(playerRepository))
                {
                    if (entry.Key != null &&
                        string.Equals(entry.Key.ToString(), kit.Category, StringComparison.OrdinalIgnoreCase))
                    {
                        categoryRepository = entry.Value;
                        break;
                    }
                }

                object playerKitsTaked = GetReflectionMember(categoryRepository, "playerKitsTaked");
                object playerKitInfo = null;
                foreach (var entry in EnumerateDictionary(playerKitsTaked))
                {
                    if (entry.Key != null &&
                        string.Equals(entry.Key.ToString(), kit.Key, StringComparison.OrdinalIgnoreCase))
                    {
                        playerKitInfo = entry.Value;
                        break;
                    }
                }

                double timestamp;
                if (!TryConvertDouble(GetReflectionMember(playerKitInfo, "cooldown"), out timestamp))
                    return 0.0;

                double remaining = timestamp - Facepunch.Math.Epoch.Current;
                return remaining > 0.0 ? remaining : 0.0;
            }
            catch (Exception ex)
            {
                PrintWarning("[InfoMenu] Ошибка получения cooldown IQKits: " + ex.Message);
                return 0.0;
            }
        }

        private string FormatCooldown(double seconds)
        {
            int total = Mathf.Max(1, Mathf.CeilToInt((float)seconds));
            int days = total / 86400;
            total %= 86400;
            int hours = total / 3600;
            total %= 3600;
            int minutes = total / 60;
            int secs = total % 60;

            if (days > 0)
                return string.Format(CultureInfo.InvariantCulture, "{0}д {1:00}ч {2:00}м", days, hours, minutes);
            if (hours > 0)
                return string.Format(CultureInfo.InvariantCulture, "{0}ч {1:00}м {2:00}с", hours, minutes, secs);
            if (minutes > 0)
                return string.Format(CultureInfo.InvariantCulture, "{0}м {1:00}с", minutes, secs);
            return string.Format(CultureInfo.InvariantCulture, "{0}с", secs);
        }

