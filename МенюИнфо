        private void OpenKitsPage(BasePlayer player, int page)
        {
            if (player == null || !player.IsConnected)
                return;

            Plugin iq = GetIQKitsPlugin();
            List<IQKitEntry> kits = GetIQKits(player);
            int pageCount = GetKitPageCount(kits);
            page = Mathf.Clamp(page, 0, pageCount - 1);

            ClearPageContent(player);
            openKitPages[player.userID] = page;

            var container = new CuiElementContainer();
            string content = MainLayer + ".KitsContent";

            // Левая колонка создаётся один раз в OpenMenu().
            // Не удаляем её при открытии китов — иначе список кнопок исчезает.

            container.Add(new CuiPanel
            {
                Image = { Color = "0 0 0 0" },
                RectTransform = { AnchorMin = "0.195 0.045", AnchorMax = "0.985 0.895" }
            }, MainLayer + ".Main", content);

            AddText(container, content, "КИТЫ", 25, TextAnchor.UpperLeft, config.TextColor,
                "0.03 0.86", "0.95 0.97", "Title");
            AddText(container, content, "НАБОРЫ IQKITS  •  ПОЛУЧИТЬ ДОСТУП К ОСТАЛЬНЫМ КИТАМ", 12,
                TextAnchor.UpperLeft, config.SecondaryTextColor, "0.032 0.80", "0.95 0.87", "Subtitle");

            container.Add(new CuiPanel
            {
                Image = { Color = ParseColor(config.GreenColor) },
                RectTransform = { AnchorMin = "0.03 0.775", AnchorMax = "0.30 0.782" }
            }, content);

            if (iq == null)
            {
                AddText(container, content,
                    "IQKits НЕ ЗАГРУЖЕН\n\nПлагин будет подключён автоматически после загрузки IQKits.",
                    16, TextAnchor.MiddleCenter, config.TextColor,
                    "0.10 0.35", "0.90 0.60", "NoPlugin");
            }
            else if (kits.Count == 0)
            {
                AddText(container, content,
                    "НАБОРЫ НЕ НАЙДЕНЫ\n\nПроверьте категории и права IQKits.",
                    16, TextAnchor.MiddleCenter, config.TextColor,
                    "0.10 0.35", "0.90 0.60", "NoKits");
            }
            else
            {
                int start = page * 6;
                int end = Mathf.Min(start + 6, kits.Count);

                for (int i = start; i < end; i++)
                {
                    int local = i - start;
                    int row = local / 2;
                    int col = local % 2;
                    float xMin = col == 0 ? 0.03f : 0.515f;
                    float xMax = col == 0 ? 0.485f : 0.97f;
                    float yMax = 0.72f - row * 0.18f;
                    float yMin = yMax - 0.15f;

                    IQKitEntry kit = kits[i];
                    string card = MainLayer + ".Kit." + i;
                    string statusKey = GetKitStatusKey(kit.Category, kit.Key);
                    double cooldown = GetKitRemainingCooldown(player, kit);
                    int usedAmount;
                    int maxAmount;
                    int kitType;
                    bool hasUsageLimit = TryGetKitUsageInfo(player, kit, out kitType, out usedAmount, out maxAmount);
                    bool kitEnded = hasUsageLimit && (kitType == 1 || kitType == 2) &&
                                    maxAmount > 0 && usedAmount >= maxAmount;
                    bool redeemed = GetRedeemedSet(player.userID).Contains(statusKey);
                    bool failed = GetFailedSet(player.userID).Contains(statusKey);
                    string inventoryFullKey;
                    bool inventoryFull = lastInventoryFullKit.TryGetValue(player.userID, out inventoryFullKey) &&
                                         string.Equals(inventoryFullKey, kit.Key, StringComparison.OrdinalIgnoreCase);

                    container.Add(new CuiPanel
                    {
                        Image = { Color = ParseColor(config.CardColor) },
                        RectTransform =
                        {
                            AnchorMin = string.Format(CultureInfo.InvariantCulture, "{0:0.###} {1:0.###}", xMin, yMin),
                            AnchorMax = string.Format(CultureInfo.InvariantCulture, "{0:0.###} {1:0.###}", xMax, yMax)
                        }
                    }, content, card);

                    AddText(container, card, (string.IsNullOrWhiteSpace(kit.Title) ? kit.Key : kit.Title).ToUpperInvariant(),
                        16, TextAnchor.MiddleLeft, config.TextColor, "0.04 0.62", "0.96 0.86", "Name");
                    AddText(container, card, "КАТЕГОРИЯ: " + kit.CategoryTitle, 10, TextAnchor.MiddleLeft,
                        config.SecondaryTextColor, "0.04 0.43", "0.68 0.58", "Category");

                    bool isCopterKit = IsCopterKitKey(kit.Key);
                    PlayerData copterData = GetPlayerData(player);
                    bool copterAvailable = isCopterKit &&
                        ((copterData != null && copterData.PendingCopterKit) ||
                         permission.UserHasPermission(player.UserIDString, "iqkits.w5"));

                    if (isCopterKit)
                    {
                        // Пока покупка не забрана — показываем ВЗЯТЬ.
                        // После успешной выдачи permission iqkits.w5 и PendingCopterKit
                        // снимаются, поэтому здесь автоматически появляется МАГАЗИН.
                        container.Add(new CuiButton
                        {
                            Button =
                            {
                                Command = copterAvailable ? "infomenu.coptertake" : "infomenu.shop category 3",
                                // Кнопка МАГАЗИН у миникоптера должна быть такой же зелёной,
                                // как магазин у остальных китов.
                                Color = ParseColor(config.GreenColor),
                                HighlightedColor = ParseColor(config.ButtonHoverColor)
                            },
                            Text =
                            {
                                Text = copterAvailable ? "ВЗЯТЬ" : "МАГАЗИН",
                                Font = config.Font,
                                FontSize = 12,
                                Align = TextAnchor.MiddleCenter,
                                Color = "0 0 0 1"
                            },
                            RectTransform = { AnchorMin = "0.70 0.08", AnchorMax = "0.94 0.28" }
                        }, card);
                    }
                    else if (!kit.IsAllowed)
                    {
                        AddKitAccessButton(container, card);
                    }
                    else if (inventoryFull)
                    {
                        AddText(container, card, "ИНВЕНТАРЬ ПОЛОН", 11, TextAnchor.MiddleCenter, config.CloseColor,
                            "0.55 0.12", "0.98 0.31", "InventoryFull");
                    }
                    else if (kitEnded)
                    {
                        AddText(container, card, "КОНЧИЛСЯ", 11, TextAnchor.MiddleCenter, config.CloseColor,
                            "0.68 0.09", "0.96 0.30", "Ended");
                    }
                    else if (cooldown > 0.0)
                    {
                        AddKitCountdown(container, card, cooldown);
                    }
                    else if (failed)
                    {
                        AddKitAccessButton(container, card);
                    }
                    else
                    {
                        container.Add(new CuiButton
                        {
                            Button =
                            {
                                Command = string.Format(CultureInfo.InvariantCulture, "infomenu.kittake {0} {1}", i, page),
                                Color = ParseColor(config.GreenColor),
                                HighlightedColor = ParseColor(config.ButtonHoverColor)
                            },
                            Text = { Text = "ВЗЯТЬ", Font = config.Font, FontSize = 12,
                                Align = TextAnchor.MiddleCenter, Color = "0 0 0 1" },
                            RectTransform = { AnchorMin = "0.70 0.08", AnchorMax = "0.94 0.28" }
                        }, card);
                    }
                }
            }

            if (page > 0)
                AddPageButton(container, content, "‹", "infomenu.kits " + (page - 1), "0.03 0.015", "0.09 0.075");
            if (page < pageCount - 1)
                AddPageButton(container, content, "›", "infomenu.kits " + (page + 1), "0.91 0.015", "0.97 0.075");

            AddText(container, content, string.Format(CultureInfo.InvariantCulture, "{0} / {1}", page + 1, pageCount),
                11, TextAnchor.MiddleCenter, config.SecondaryTextColor, "0.40 0.015", "0.60 0.075", "Pages");

            CuiHelper.AddUi(player, container);
        }

