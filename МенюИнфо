        private void BeginGameStorePurchase(BasePlayer player, int index)
        {
            if (player == null || !player.IsConnected)
                return;

            if (index < 0 || index >= gameStoreProducts.Count)
            {
                OpenShopPage(player);
                return;
            }

            if (gameStorePurchasesInProgress.Contains(player.userID))
            {
                player.ChatMessage("<color=#FFD21F>GameStores: предыдущая покупка ещё обрабатывается.</color>");
                return;
            }

            GameStoreProduct product = gameStoreProducts[index];
            if (product == null || product.Price <= 0)
                return;

            Plugin plugin = GameStoresRUST ?? plugins.Find("GameStoresRUST");
            if (plugin == null)
            {
                player.ChatMessage("<color=#ff4444>GameStores: плагин магазина не найден.</color>");
                return;
            }

            gameStorePurchasesInProgress.Add(player.userID);
            player.ChatMessage("<color=#55ff22>Проверяем баланс GameStores для покупки «" + EscapeText(product.Title) + "»...</color>");

            RequestGameStoreBalanceForPurchase(player, plugin, product);
        }

        private void RequestGameStoreBalanceForPurchase(BasePlayer player, Plugin plugin, GameStoreProduct product)
        {
            try
            {
                MethodInfo method = plugin.GetType().GetMethod(
                    "API_GetPlayerBalance",
                    BindingFlags.Instance | BindingFlags.NonPublic);

                if (method == null)
                {
                    FinishGameStorePurchase(player, false, "API баланса GameStores не найден.");
                    return;
                }

                ulong steamId;
                if (!ulong.TryParse(player.UserIDString, out steamId) || steamId == 0)
                {
                    FinishGameStorePurchase(player, false, "SteamID игрока не определён.");
                    return;
                }

                Action<bool, string> callback = (success, value) =>
                {
                    if (player == null || !player.IsConnected)
                    {
                        if (player != null)
                            gameStorePurchasesInProgress.Remove(player.userID);
                        return;
                    }

                    if (!success)
                    {
                        FinishGameStorePurchase(player, false, "Не удалось получить баланс GameStores.");
                        return;
                    }

                    decimal balance;
                    string normalized = (value ?? "0").Trim().Replace(',', '.');
                    if (!decimal.TryParse(normalized, NumberStyles.Any, CultureInfo.InvariantCulture, out balance))
                    {
                        FinishGameStorePurchase(player, false, "GameStores вернул некорректный баланс.");
                        return;
                    }

                    if (balance < product.Price)
                    {
                        FinishGameStorePurchase(player, false,
                            "Недостаточно средств. Нужно " + product.Price.ToString(CultureInfo.InvariantCulture) +
                            " ₽, доступно " + balance.ToString("0.##", CultureInfo.InvariantCulture) + " ₽.");
                        return;
                    }

                    ChangeGameStoreBalanceForPurchase(player, plugin, product, steamId);
                };

                method.Invoke(plugin, new object[] { steamId, callback });
            }
            catch (Exception ex)
            {
                PrintWarning("[InfoMenu] Ошибка проверки баланса перед покупкой: " + ex.Message);
                FinishGameStorePurchase(player, false, "Ошибка API GameStores при проверке баланса.");
            }
        }

        private void ChangeGameStoreBalanceForPurchase(BasePlayer player, Plugin plugin, GameStoreProduct product, ulong steamId)
        {
            try
            {
                MethodInfo method = plugin.GetType().GetMethod(
                    "API_ChangePlayerBalance",
                    BindingFlags.Instance | BindingFlags.NonPublic,
                    null,
                    new Type[]
                    {
                        typeof(ulong),
                        typeof(int),
                        typeof(string),
                        typeof(string),
                        typeof(Action<bool, string>)
                    },
                    null);

                if (method == null)
                {
                    FinishGameStorePurchase(player, false, "API списания GameStores не найден.");
                    return;
                }

                Action<bool, string> callback = (success, value) =>
                {
                    if (player == null)
                    {
                        return;
                    }

                    if (!success)
                    {
                        FinishGameStorePurchase(player, false, "GameStores не подтвердил списание средств.");
                        return;
                    }

                    bool granted = GrantPurchasedProduct(player, product);
                    if (!granted)
                    {
                        // Пытаемся вернуть деньги, если серверная выдача не была выполнена.
                        RefundGameStoreBalance(player, plugin, steamId, product.Price);
                        FinishGameStorePurchase(player, false, "Не удалось выдать товар. Средства возвращаются.");
                        return;
                    }

                    FinishGameStorePurchase(player, true,
                        "Покупка «" + EscapeText(product.Title) + "» выполнена. Списано " +
                        product.Price.ToString(CultureInfo.InvariantCulture) + " ₽.");
                };

                string message = "InfoMenu: покупка " + product.Title;
                method.Invoke(plugin, new object[] { steamId, product.Price, "minus", message, callback });
            }
            catch (Exception ex)
            {
                PrintWarning("[InfoMenu] Ошибка списания GameStores: " + ex.Message);
                FinishGameStorePurchase(player, false, "Ошибка списания средств GameStores.");
            }
        }

        private bool GrantPurchasedProduct(BasePlayer player, GameStoreProduct product)
        {
            if (player == null || !player.IsConnected || product == null)
                return false;

            try
            {
                string steamId = player.UserIDString;

                if (!string.IsNullOrEmpty(product.Group))
                {
                    // VIP/PREMIUM/ELITE выдаются на 7 дней. Повторная покупка
                    // не сбрасывает срок, а добавляет ещё 7 дней к текущему сроку.
                    AddTierDays(player, product.Group, 7);
                    SetPurchasedChatGroup(player, product.Group);
                    SyncPurchasedStatus(player, false);
                    return true;
                }

                // КОПТЕР не использует GrantCommand/GameStores-команды.
                // GameStores считает покупку успешно выданной сразу после выдачи
                // права IQKits. После фактического получения w5 это право снимается.
                // Дополнительно запускается 10-минутный таймер следующей покупки.
                if (string.Equals(product.Title, "КОПТЕР", StringComparison.OrdinalIgnoreCase))
                {
                    permission.GrantUserPermission(player.UserIDString, "iqkits.w5", this);

                    PlayerData data = GetPlayerData(player);
                    if (data != null)
                    {
                        data.PendingCopterKit = true;
                        // После покупки следующая покупка коптера блокируется на 10 минут.
                        data.CopterRefreshAt = CurrentUnix() + 600L;
                    }

                    SaveData();
                    return true;
                }

                if (!string.IsNullOrEmpty(product.GrantCommand))
                {
                    string command = product.GrantCommand.Replace("%STEAMID%", steamId);
                    Server.Command(command);

                    PlayerData data = GetPlayerData(player);
                    if (data != null)
                    {
                        long now = CurrentUnix();
                        if (string.Equals(product.Title, "СКИНЫ", StringComparison.OrdinalIgnoreCase))
                        {
                            // 14 дней = 1209600 секунд.
                            data.SkinsRefreshAt = now + 1209600L;
                        }
                        else if (string.Equals(product.Title, "КОПТЕР", StringComparison.OrdinalIgnoreCase))
                        {
                            permission.GrantUserPermission(player.UserIDString, "iqkits.w5", this);
                            data.PendingCopterKit = true;
                            data.CopterRefreshAt = now + 600L;
                        }
                        SaveData();
                    }

                    return true;
                }
            }
            catch (Exception ex)
            {
                PrintWarning("[InfoMenu] Ошибка выдачи товара " + product.Title + ": " + ex.Message);
            }

            return false;
        }

        private void RefundGameStoreBalance(BasePlayer player, Plugin plugin, ulong steamId, int amount)
        {
            if (plugin == null || amount <= 0)
                return;

            try
            {
                MethodInfo method = plugin.GetType().GetMethod(
                    "API_ChangePlayerBalance",
                    BindingFlags.Instance | BindingFlags.NonPublic,
                    null,
                    new Type[]
                    {
                        typeof(ulong),
                        typeof(int),
                        typeof(string),
                        typeof(string),
                        typeof(Action<bool, string>)
                    },
                    null);

                if (method == null)
                    return;

                Action<bool, string> callback = (success, value) =>
                {
                    if (!success)
                        PrintWarning("[InfoMenu] GameStores: НЕ УДАЛОСЬ вернуть " + amount.ToString(CultureInfo.InvariantCulture) + " ₽ игроку " + player.UserIDString);
                };

                method.Invoke(plugin, new object[]
                {
                    steamId,
                    amount,
                    "plus",
                    "InfoMenu: возврат за невыданный товар",
                    callback
                });
            }
            catch (Exception ex)
            {
                PrintWarning("[InfoMenu] Ошибка возврата GameStores: " + ex.Message);
            }
        }

        private void FinishGameStorePurchase(BasePlayer player, bool success, string message)
        {
            if (player == null)
                return;

            gameStorePurchasesInProgress.Remove(player.userID);

            if (player.IsConnected)
            {
                if (!string.IsNullOrEmpty(message))
                    player.ChatMessage(success
                        ? "<color=#55ff22>GameStores: " + message + "</color>"
                        : "<color=#ff5555>GameStores: " + message + "</color>");

                // Обновляем только баланс и содержимое магазина — без закрытия InfoMenu,
                // без открытия браузера и без рекурсивного перерисовывания меню.
                if (success)
                    timer.Once(0.35f, () =>
                    {
                        if (player == null || !player.IsConnected)
                            return;

                        // После покупки КОПТЕРА сразу открываем КИТЫ,
                        // чтобы игрок гарантированно увидел кнопку ВЗЯТЬ.
                        PlayerData purchasedData = GetPlayerData(player);
                        if (purchasedData != null && purchasedData.PendingCopterKit)
                            OpenKitsPage(player, 0);
                        else
                            OpenShopPage(player);
                    });
                else
                    timer.Once(0.15f, () =>
                    {
                        if (player != null && player.IsConnected)
                            RequestGameStoreBalance(player, MainLayer + ".Content.GameStore");
                    });
            }
        }
