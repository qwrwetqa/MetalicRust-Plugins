            RequestGameStoreBalance(player, shopLayer);

            // Категории — только навигация внутри магазина. Реальные товары ниже.
            string[] categories = { "ВСЕ", "ПРИВИЛЕГИИ", "СКИНЫ", "КОПТЕРЫ" };
            for (int i = 0; i < categories.Length; i++)
            {
                float xMin = 0.025f + i * 0.18f;
                float xMax = xMin + 0.17f;
                int selectedCategory = 0;
                if (openShopCategories.ContainsKey(player.userID))
                    selectedCategory = Mathf.Clamp(openShopCategories[player.userID], 0, categories.Length - 1);
                bool selected = i == selectedCategory;

                container.Add(new CuiButton
                {
                    Button =
                    {
                        Command = "infomenu.shop category " + i,
                        Color = selected ? ParseColor(config.GreenColor) : "0.22 0.24 0.24 1",
                        HighlightedColor = ParseColor(config.ButtonHoverColor)
                    },
                    Text =
                    {
                        Text = categories[i],
                        Font = config.Font,
                        FontSize = 10,
                        Align = TextAnchor.MiddleCenter,
                        Color = selected ? "0.02 0.04 0.02 1" : "0.9 0.9 0.9 1"
                    },
                    RectTransform =
                    {
                        AnchorMin = string.Format(CultureInfo.InvariantCulture, "{0:0.###} 0.755", xMin),
                        AnchorMax = string.Format(CultureInfo.InvariantCulture, "{0:0.###} 0.815", xMax)
                    }
                }, shopLayer);
            }

            // Товары распределяются по категориям:
            // ВСЕ — все товары; ПРИВИЛЕГИИ — VIP/PREMIUM/ELITE;
            // СКИНЫ — только скины; КОПТЕРЫ — только коптер.
            int selectedCategoryForProducts = 0;
            if (openShopCategories.ContainsKey(player.userID))
                selectedCategoryForProducts = Mathf.Clamp(openShopCategories[player.userID], 0, 3);

            List<int> visibleProductIndices = new List<int>();
            for (int productIndex = 0; productIndex < gameStoreProducts.Count; productIndex++)
            {
                GameStoreProduct product = gameStoreProducts[productIndex];
                if (product != null &&
                    (selectedCategoryForProducts == 0 ||
                     GetShopProductCategory(product) == selectedCategoryForProducts))
                {
                    visibleProductIndices.Add(productIndex);
                }
            }

            int columns = 3;
            int rows = Mathf.Max(1, Mathf.CeilToInt(visibleProductIndices.Count / (float)columns));
            float left = 0.025f;
            float right = 0.975f;
            float top = 0.735f;
            float bottom = 0.08f;
            float gapX = 0.018f;
            float gapY = 0.025f;
            float cardW = (right - left - gapX * (columns - 1)) / columns;
            float availableHeight = top - bottom;
            float cardH = Mathf.Min(0.30f, (availableHeight - gapY * (rows - 1)) / rows);

            for (int visibleIndex = 0; visibleIndex < visibleProductIndices.Count; visibleIndex++)
            {
                int i = visibleProductIndices[visibleIndex];
                GameStoreProduct product = gameStoreProducts[i];
                int col = visibleIndex % columns;
                int row = visibleIndex / columns;
                float xMin = left + col * (cardW + gapX);
                float xMax = xMin + cardW;
                float yMax = top - row * (cardH + gapY);
                float yMin = yMax - cardH;
                string card = shopLayer + ".Product." + i;

                container.Add(new CuiPanel
